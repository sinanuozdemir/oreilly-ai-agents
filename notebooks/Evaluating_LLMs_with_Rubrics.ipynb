      "source": [
        "# More on positional bias"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 28,
      "id": "8885015c-9194-4a67-a4b2-31359aeb04da",
      "metadata": {},
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "### Rating Task\n",
            "Rate the performance of two assistants in response to the user question.\n",
            "\n",
            "Output a score from 1 to 3 where a 1 means you strongly prefer Assistant 1's answer and 3 means you strongly prefer Assistant 2's answer and 2 means either answer works just as well as the other.\n",
            "\n",
            "Respond with valid JSON only in this format:\n",
            "\n",
            "JSON: {json_format}\n"
          ]
        }
      ],
      "source": [
        "import re\n",
        "\n",
        "SYSTEM_PROMPT = \"### Rating Task\\nRate the performance of two assistants in response to the user question.\\n\\nOutput a score from 1 to 3 where a 1 means you strongly prefer Assistant 1's answer and 3 means you strongly prefer Assistant 2's answer and 2 means either answer works just as well as the other.\\n\\nRespond with valid JSON only in this format:\\n\\nJSON: {json_format}\"\n",
        "\n",
        "print(SYSTEM_PROMPT)\n",
        "\n",
        "def parse_supervision_json(text, cot=False):\n",
        "    text = (text or '').strip()\n",
        "    if not text:\n",
        "        raise ValueError('Empty model response')\n",
        "\n",
        "    if '```' in text:\n",
        "        text = re.sub(r'^```(?:json)?\\s*', '', text)\n",
        "        text = re.sub(r'\\s*```$', '', text).strip()\n",
        "\n",
        "    if 'JSON:' in text:\n",
        "        text = text.split('JSON:')[-1].strip()\n",
        "\n",
        "    try:\n",
        "        return json.loads(text)\n",
        "    except json.JSONDecodeError:\n",
        "        pass\n",
        "\n",
        "    match = re.search(r'\\{.*\\}', text, re.DOTALL)\n",
        "    if match:\n",
        "        try:\n",
        "            return json.loads(match.group())\n",
        "        except json.JSONDecodeError:\n",
        "            pass\n",
        "\n",
        "    score_match = re.search(r'\"score\"\\s*:\\s*([123])', text)\n",
        "    if score_match:\n",
        "        result = {'score': int(score_match.group(1))}\n",
        "        if cot:\n",
        "            reason_match = re.search(r'\"reason\"\\s*:\\s*\"([^\"]*)\"', text)\n",
        "            if reason_match:\n",
        "                result['reason'] = reason_match.group(1)\n",
        "        return result\n",
        "\n",
        "    raise ValueError(f'Could not parse JSON from: {text!r}')\n",
        "\n",
        "def preferred_agent_from_score(score, reverse=False):\n",
        "  \"\"\"Map supervision score back to agent_1 / agent_2, accounting for position swap.\"\"\"\n",
        "  if score == 2:\n",
        "      return 'tie'\n",
        "  if not reverse:\n",
        "      return 'agent_1' if score == 1 else 'agent_2'\n",
        "  return 'agent_2' if score == 1 else 'agent_1'\n",
        "\n",
        "def get_supervision(query, answer_1, answer_2, cot=False, model='glm-5p2-fast'):\n",
        "    if cot:\n",
        "        json_format = \"\"\"{\\\"reason\\\": \\\"1 sentence outlining the pros and cons of each response.\\\", \\\"score\\\": Y}\"\"\"\n",
        "    else:\n",
        "        json_format = \"\"\"{\\\"score\\\": Y}\"\"\"\n",
        "    response = llms[model].invoke(\n",
        "      [\n",
        "        SystemMessage(content=SYSTEM_PROMPT.format(json_format=json_format)),\n",
        "        HumanMessage(content=f\"### User Question\\n{query}\\n\\n### The Start of Assistant 1's Answer\\n{answer_1}\\n### The End of Assistant 1's Answer\\n\\n### The Start of Assistant 2's Answer\\n{answer_2}\\n### The End of Assistant 2's Answer\\n\\nNow give your answer\\nJSON:\")\n",
        "      ],\n",
        "      temperature=0,\n",
        "      max_tokens=1024,\n",
        "    )\n",
        "    \n",
        "    return parse_supervision_json(response.content, cot=cot)"
      ]
    },
