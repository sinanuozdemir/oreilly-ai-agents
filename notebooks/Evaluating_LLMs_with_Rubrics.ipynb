      "source": [
        "from tqdm import tqdm\n",
        "import pandas as pd\n",
        "\n",
        "results = []\n",
        "n = 100\n",
        "for cot in tqdm(range(0,2), desc=\"Cot\"):\n",
        "    index = 0\n",
        "    for _ in tqdm(range(n), desc=\"N\"):\n",
        "        if index < n // 2:  # half will be reversed, half won't\n",
        "            _result = get_supervision(\n",
        "                query='Tell me about Sinan Ozdemir', \n",
        "                answer_1=agent_1, answer_2=agent_2, cot=cot\n",
        "            )\n",
        "            _result.update(dict(cot=bool(cot), reverse=False))\n",
        "        else:\n",
        "            _result = get_supervision(\n",
        "                    query='Tell me about Sinan Ozdemir', \n",
        "                    answer_1=agent_2, answer_2=agent_1\n",
        "                )\n",
        "            _result.update(dict(cot=bool(cot), reverse=True))\n",
        "        _result['preferred_agent'] = preferred_agent_from_score(\n",
        "            _result['score'], reverse=_result['reverse']\n",
        "        )\n",
        "        results.append(_result)\n",
        "        index += 1\n",
        "\n",
        "summary = pd.DataFrame(results).groupby(['cot', 'reverse', 'preferred_agent']).size().unstack(fill_value=0)\n",
        "summary\n"
      ]
    },
