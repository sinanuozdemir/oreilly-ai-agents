        "rubric_template = '''### Rating Task\n",
        "\n",
        "The goal is to evaluate an assistant’s answer to a user’s query using reference answers and criteria.\n",
        "\n",
        "I will ask you to rate the output on a scale from 1-10 on the following criteria:\n",
        "\n",
        "{criteria}\n",
        "\n",
        "Respond with exactly {num_criteria} integers from 1 to 10 in a Python list.\n",
        "\n",
        "Examples:\n",
        "Answer: [1, 8, 3, 10, 5]\n",
        "Answer: [10, 3, 7, 9, 8]\n",
        "Answer: [2, 3, 5, 10, 6]\n",
        "\n",
        "### User Question\n",
        "{query}\n",
        "\n",
        "### Beginning of reference answers\n",
        "{references}\n",
        "### End of reference answers\n",
        "\n",
        "### Beginning of the Assistant's answer\n",
        "{llm_output}\n",
        "### End of the Assistant's answer\n",
        "\n",
        "Now give your answer as integers only.\n",
        "Answer:'''\n",
        "\n",
        "def parse_rubric_scores(text, expected_count):\n",
        "    text = text.strip()\n",
        "    if 'Answer:' in text:\n",
        "        text = text.split('Answer:')[-1].strip()\n",
        "\n",
        "    bracket_match = re.search(r'\\[([^\\]]*)\\]', text)\n",
        "    if bracket_match:\n",
        "        nums = [int(x) for x in re.findall(r'\\b(?:10|[1-9])\\b', bracket_match.group(1))]\n",
        "        if len(nums) >= expected_count:\n",
        "            return nums[:expected_count]\n",
        "\n",
        "    nums = [int(x) for x in re.findall(r'\\b(?:10|[1-9])\\b', text)]\n",
        "    if len(nums) >= expected_count:\n",
        "        return nums[:expected_count]\n",
        "\n",
        "    raise ValueError(f'Could not parse {expected_count} scores from: {text!r}')\n",
        "\n",
        "def eval_free_text_rubric(question, output, references, verbose=False):\n",
        "    rubric = rubric_template.replace(\n",
        "        '{query}', question\n",
        "        ).replace(\n",
        "            '{references}','\\n'.join(references)\n",
        "            ).replace(\n",
        "            '{llm_output}', output\n",
        "            ).replace(\n",
        "                '{criteria}', '\\n'.join(criteria)\n",
        "            ).replace(\n",
        "                '{num_criteria}', str(len(criteria))\n",
        "            )\n",
        "    if verbose:\n",
        "        print(rubric)\n",
        "    results = dict()\n",
        "    for model in DEFAULT_EVAL_MODELS:\n",
        "        response = llms[model].invoke(\n",
        "            [HumanMessage(content=rubric)],\n",
        "        )\n",
        "        result = response.content.strip()\n",
        "\n",
        "        try:\n",
        "            results[model] = parse_rubric_scores(result, len(criteria))\n",
        "        except Exception as e:\n",
        "            print(f'Error with {model}. {result}')\n",
        "            results[model] = None\n",
        "\n",
        "    return results"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
