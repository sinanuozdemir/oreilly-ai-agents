        "\n",
        "fig, ax = plt.subplots(figsize=(5, 3))\n",
        "\n",
        "# Plot the data for each COT value\n",
        "for i, (cot_value, group) in enumerate(grouped):\n",
        "    counts, _ = np.histogram(group, bins=bins)\n",
        "    ax.bar(\n",
