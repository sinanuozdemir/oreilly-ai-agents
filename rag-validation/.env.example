# RAG Evaluation Environment Variables

# Required: OpenAI API Key for LLM-based evaluation
OPENAI_API_KEY=sk-your-api-key-here

# Optional: LangSmith API Key for tracing (recommended for debugging)
LANGCHAIN_API_KEY=ls-your-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=rag-evaluation

# Optional: Hugging Face Token (for downloading models)
HUGGINGFACE_TOKEN=hf_your_token_here

# Optional: Anthropic API Key (alternative LLM for evaluation)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Optional: Cohere API Key (for reranking)
COHERE_API_KEY=your-cohere-api-key

# Evaluation Settings
EVAL_TEST_SIZE=100
EVAL_METRICS=all
OUTPUT_FORMAT=markdown

# Performance Settings
MAX_WORKERS=4
BATCH_SIZE=10

# CI/CD Settings
FAIL_ON_REGRESSION=true
POST_PR_COMMENT=true
