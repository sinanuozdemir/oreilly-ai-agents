# ⚠️ NOTE: The code reads credentials from the .env at the WORKSPACE ROOT
# (oreilly-ai-agents/.env), NOT from this folder. This file is just a template
# showing which keys are needed — add these to your root .env.
# Values come from: PingOne console > ai-test-lab > Applications > admin-worker > Configuration

PINGONE_ENVIRONMENT_ID=your-environment-id-here
PINGONE_CLIENT_ID=your-client-id-here
PINGONE_CLIENT_SECRET=your-client-secret-here
PINGONE_REGION=com
